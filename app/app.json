{
  "expo": {
    "name": "Fore Wheels",
    "slug": "forewheels",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forewheels",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.forewheelsdetailing.app",
      "supportsTablet": false,
      "appleTeamId": "NVKSSW8ZV6",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6A4DF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170
        }
      ],
      "expo-image",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#6A4DF4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "joycem2123",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cdc2ece1-154d-42b0-b072-eaa34d5cc9ab"
      }
    }
  }
}
